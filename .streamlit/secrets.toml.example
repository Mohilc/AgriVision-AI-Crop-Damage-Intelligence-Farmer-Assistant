# AgriVision Configuration Secrets Template
# Copy this file to .streamlit/secrets.toml or set environment variables in your system / .env

# Meta Llama 3.2 11B Vision Key (Primary Vision & Diagnostic Engine)
META_LLAMA_API_KEY = "your-nvidia-llama-vision-key-here"

# Moonshot AI Kimi Key (Secondary / Agronomy Q&A Engine)
KIMI_API_KEY = "your-nvidia-kimi-key-here"

# NVIDIA Nemotron Key (Reasoning Engine)
NEMOTRON_API_KEY = "your-nvidia-nemotron-key-here"

# General NVIDIA Key (default fallback for NVIDIA NIM API)
NVIDIA_API_KEY = "your-nvidia-api-key-here"
NVIDIA_BACKUP_API_KEY = "your-backup-nvidia-key-optional"

# Google Gemini Fallback Key
GEMINI_API_KEY = "your-gemini-api-key-here"

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"
